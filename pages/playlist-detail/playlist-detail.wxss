/* 歌单详情页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.scrollarea {
  flex: 1;
}

.container {
  padding: 32rpx;
  padding-bottom: 320rpx;
}

/* ===== 歌单头部 ===== */
.playlist-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
}

.playlist-info {
  flex: 1;
}

.playlist-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 12rpx;
}

.song-count {
  font-size: 28rpx;
  color: #8B7D6B;
}

.edit-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.edit-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.edit-icon {
  font-size: 32rpx;
}

/* ===== 歌曲列表 ===== */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.song-index {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

.song-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 20rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  transition: all 0.3s ease;
}

.song-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.song-name {
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 500;
}

.song-artist {
  font-size: 26rpx;
  color: #8B7D6B;
}

.song-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.btn-icon {
  font-size: 28rpx;
  color: #5C5143;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.7;
}

.empty-text {
  font-size: 34rpx;
  color: #2C2419;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 添加歌曲按钮 ===== */
.add-btn-container {
  position: fixed;
  bottom: 180rpx;
  right: 40rpx;
  z-index: 100;
}

.add-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.add-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.add-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* ===== 开始街唱按钮 ===== */
.start-btn-container {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  z-index: 100;
}

.start-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(224, 122, 95, 0.4);
  transition: all 0.3s ease;
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(224, 122, 95, 0.3);
}

.start-btn[disabled] {
  background: #E8E0D4;
  color: #B5A99A;
  box-shadow: none;
}

/* ===== 模态框 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 640rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  padding: 48rpx;
  box-shadow:
    0 20rpx 60rpx rgba(44, 36, 25, 0.2),
    0 8rpx 24rpx rgba(212, 165, 116, 0.15);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 40rpx;
  text-align: center;
}

.modal-body {
  margin-bottom: 40rpx;
}

.modal-input {
  width: 100%;
  height: 88rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #2C2419;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.modal-input:focus {
  border-color: #D4A574;
  background: #FFFFFF;
}

.modal-input::placeholder {
  color: #B5A99A;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #F5F0E8;
  color: #5C5143;
}

.cancel-btn:active {
  background: #E8E0D4;
}

.confirm-btn {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
}

.confirm-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

/* ===== 操作菜单（全局一致样式） ===== */
.action-menu {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 999;
  padding-bottom: 60rpx;
}

.action-menu.show {
  opacity: 1;
  pointer-events: auto;
}

.menu-content {
  width: 640rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  padding: 16rpx 0;
  box-shadow:
    0 20rpx 60rpx rgba(44, 36, 25, 0.2),
    0 8rpx 24rpx rgba(212, 165, 116, 0.15);
  overflow: hidden;
}

.menu-header {
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: #8B7D6B;
  text-align: center;
  border-bottom: 2rpx solid #F0EBE3;
  margin-bottom: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #2C2419;
  transition: all 0.2s ease;
}

.menu-item:active {
  background: #F5F0E8;
}

.menu-item.delete {
  color: #E07A5F;
}

.menu-item.delete:active {
  background: rgba(224, 122, 95, 0.1);
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-divider {
  height: 2rpx;
  background: #F0EBE3;
  margin: 0 32rpx;
}
