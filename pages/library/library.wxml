<navigation-bar title="我的曲库" back="{{true}}" color="black" background="#FAF7F2"></navigation-bar>

<!-- 固定搜索栏（不在滚动区内，避免滚动时闪烁） -->
<view wx:if="{{allSongs.length > 0 && songs !== null}}" class="search-bar-fixed">
  <view class="search-bar">
    <icon name="search" size="28rpx" color="#B5A99A" />
    <input class="search-input" placeholder="搜索歌曲或歌手" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" />
    <text wx:if="{{searchQuery}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>
</view>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
  <!-- 加载状态 -->
  <view wx:if="{{songs === null}}" class="loading-state">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{allSongs.length === 0}}" class="empty-state">
    <view class="empty-icon">
      <icon name="music" size="80rpx" color="#D4A574" />
    </view>
    <view class="empty-text">曲库还是空的</view>
    <view class="empty-desc">添加你喜欢的歌曲吧</view>
    <view class="add-btn" bindtap="showAddSheet">
      <icon name="plus" size="36rpx" color="#FFFFFF" />
      <text>添加歌曲</text>
    </view>
  </view>

  <!-- 歌曲列表 / 搜索无结果 -->
  <view wx:else class="song-list-section">
    <view wx:if="{{songs.length === 0}}" class="search-empty">
      <text class="search-empty-text">未找到匹配的歌曲</text>
    </view>

    <view wx:else class="song-list">
    <view wx:for="{{songs}}" wx:key="id" class="song-item">
      <view class="song-index">{{index + 1}}</view>

      <view class="song-card">
        <view class="song-info">
          <view class="song-name">{{item.name}}</view>
          <view class="song-artist">{{item.artist}}</view>
        </view>

        <view class="song-actions">
          <view class="action-btn sort-btn" bindtap="showSortOptions" data-index="{{index}}">
            <icon name="sort" size="24rpx" color="#5C5143" />
          </view>
          <view class="action-btn more-btn" bindtap="showMoreOptions" data-id="{{item.id}}" data-index="{{index}}">
            <icon name="more" size="24rpx" color="#5C5143" />
          </view>
        </view>
      </view>
    </view>
  </view>
  </view>
  </view>
</scroll-view>

<!-- 添加按钮（悬浮） -->
<view wx:if="{{allSongs.length > 0}}" class="fab-add" bindtap="showAddSheet">
  <icon name="plus" size="48rpx" color="#FFFFFF" />
</view>

<!-- 添加方式选择弹窗 -->
<view wx:if="{{showAddSheet}}" class="action-sheet-mask" bindtap="hideAddSheet">
  <view class="action-sheet" catchtap="preventBubble">
    <view class="sheet-title">添加歌曲</view>
    <view class="action-item" bindtap="goManualAdd">
      <text>手动添加</text>
    </view>
    <view class="divider"></view>
    <view class="action-item" bindtap="goPlaylistImport">
      <text>QQ音乐导入</text>
    </view>
    <view class="divider"></view>
    <view class="action-item cancel" bindtap="hideAddSheet">
      <text>取消</text>
    </view>
  </view>
</view>

<!-- 更多操作弹窗 -->
<view wx:if="{{showActionSheet}}" class="action-sheet-mask" bindtap="hideActionSheet">
  <view class="action-sheet" catchtap="preventBubble">
    <view class="action-item" bindtap="editSong">
      <icon name="edit" size="32rpx" color="#5C5143" />
      <text>修改</text>
    </view>
    <view class="divider"></view>
    <view class="action-item delete" bindtap="deleteSong">
      <icon name="delete" size="32rpx" color="#E07A5F" />
      <text>删除</text>
    </view>
  </view>
</view>