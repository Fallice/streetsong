/* 曲库页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

/* ===== 加载状态 ===== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E0D4;
  border-top: 4rpx solid #D4A574;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8B7D6B;
  font-weight: 500;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  margin-bottom: 24rpx;
  opacity: 0.5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 34rpx;
  color: #2C2419;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8B7D6B;
  margin-bottom: 40rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 48rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.add-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 固定搜索栏（在滚动区外） ===== */
.search-bar-fixed {
  flex-shrink: 0;
  padding: 0 32rpx 20rpx;
  background: #FAF7F2;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(44, 36, 25, 0.04);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2C2419;
}

.search-input::placeholder {
  color: #B5A99A;
}

.search-clear {
  font-size: 28rpx;
  color: #B5A99A;
  padding: 8rpx;
}

.search-empty {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.search-empty-text {
  font-size: 28rpx;
  color: #B5A99A;
}

/* ===== 歌曲列表 ===== */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.song-index {
  width: 48rpx;
  font-size: 26rpx;
  color: #B5A99A;
  text-align: center;
  font-weight: 500;
}

.song-card {
  flex: 1;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  transition: all 0.3s ease;
}

.song-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.song-name {
  font-size: 30rpx;
  color: #2C2419;
  font-weight: 500;
}

.song-artist {
  font-size: 24rpx;
  color: #8B7D6B;
}

.song-actions {
  display: flex;
  gap: 12rpx;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 悬浮添加按钮 ===== */
.fab-add {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
  z-index: 100;
}

.fab-add:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.fab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 操作弹窗 ===== */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 40rpx;
}

.action-sheet {
  width: 640rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  padding: 16rpx 0;
  box-shadow:
    0 20rpx 60rpx rgba(44, 36, 25, 0.2),
    0 8rpx 24rpx rgba(212, 165, 116, 0.15);
}

.sheet-title {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8B7D6B;
  font-weight: 500;
}

.action-item {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  color: #2C2419;
  transition: all 0.2s ease;
}

.action-item:active {
  background: #F5F0E8;
}

.action-item.delete {
  color: #E07A5F;
}

.action-item.delete:active {
  background: rgba(224, 122, 95, 0.1);
}

.action-item.cancel {
  color: #8B7D6B;
}

.item-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider {
  height: 2rpx;
  background: #F0EBE3;
  margin: 0 32rpx;
}
