/* 歌单二维码页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  background: #FAF7F2;
}

.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 二维码卡片 ===== */
.qr-card {
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 32rpx;
  padding: 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow:
    0 8rpx 32rpx rgba(212, 165, 116, 0.12),
    0 2rpx 8rpx rgba(44, 36, 25, 0.06);
  margin-top: 40rpx;
}

.card-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.playlist-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.playlist-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2419;
  text-align: center;
}

/* ===== 二维码区域 ===== */
.qr-container {
  width: 400rpx;
  height: 400rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(44, 36, 25, 0.06);
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
}

.qr-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #F0EBE3;
  border-top-color: #D4A574;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #8B7D6B;
  font-size: 28rpx;
}

.qr-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #8B7D6B;
}

/* 二维码类型标签 */
.qr-type-badge {
  margin-top: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.qr-type-badge.real {
  background: #E8F5E9;
  color: #2E7D32;
}

.qr-type-badge.simulated {
  background: #FFF3E0;
  color: #E65100;
}

.tip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 操作按钮 ===== */
.action-btns {
  width: 100%;
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.save-btn,
.share-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
  transition: all 0.3s ease;
}

.save-btn::after,
.share-btn::after {
  border: none;
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn.enabled {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(212, 165, 116, 0.4);
}

.save-btn.enabled:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(212, 165, 116, 0.3);
}

.save-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
}

.share-btn.enabled {
  background: #FFFFFF;
  color: #2C2419;
  border: 2rpx solid #E8E0D4;
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.1);
}

.share-btn.enabled:active {
  background: #FAF7F2;
  transform: scale(0.98);
}

.share-btn.disabled {
  background: #F5F0E8;
  color: #B5A99A;
  border: 2rpx solid #E8E0D4;
}

/* 隐藏的Canvas */
.qr-canvas {
  position: absolute;
  left: -9999rpx;
  top: -9999rpx;
  width: 400rpx;
  height: 400rpx;
}

/* ===== 开发测试区域 ===== */
.dev-section {
  margin-top: 60rpx;
  padding: 32rpx;
  background: rgba(224, 122, 95, 0.08);
  border-radius: 20rpx;
  border: 2rpx dashed #E07A5F;
}

.dev-title {
  font-size: 28rpx;
  color: #E07A5F;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.dev-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(224, 122, 95, 0.4);
  transition: all 0.3s ease;
}

.dev-btn::after {
  border: none;
}

.dev-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 95, 0.3);
}

.dev-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #E07A5F;
  text-align: center;
  opacity: 0.8;
}

/* ===== 重新生成区域 ===== */
.regenerate-section {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.regenerate-hint {
  font-size: 24rpx;
  color: #B5A99A;
}

.regenerate-link {
  font-size: 26rpx;
  color: #8B7D6B;
  padding: 8rpx 24rpx;
}
