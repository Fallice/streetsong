<navigation-bar title="我的演出" back="{{true}}" color="black" background="#FAF7F2"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view wx:if="{{userInfo}}">
      <!-- 进行中的演出 -->
      <view class="section">
        <view class="section-header">
          <text class="section-icon">🎤</text>
          <view class="section-title">进行中的演出</view>
        </view>

        <view class="performance-list">
          <view wx:for="{{ongoingPerformances}}" wx:key="id"
                class="performance-card"
                bindtap="viewPerformance"
                data-performance-id="{{item.id}}">
            <view class="performance-info">
              <view class="performance-title">{{item.title}}</view>
              <view class="performance-time">开始于 {{formatTime(item.startTime)}}</view>
              <view class="performance-stats">
                <view class="stat-item">
                  <text class="stat-icon">👥</text>
                  <text>{{item.audienceCount}} 观众</text>
                </view>
                <view class="stat-item">
                  <text class="stat-icon">🎵</text>
                  <text>{{item.singingList.length}} 歌曲</text>
                </view>
              </view>
            </view>
            <view class="performance-status ongoing">进行中</view>
          </view>
        </view>

        <view wx:if="{{ongoingPerformances.length === 0}}" class="empty-state">
          <view class="empty-icon">🎤</view>
          <view class="empty-text">暂无进行中的演出</view>
        </view>
      </view>

      <!-- 已结束的演出 -->
      <view class="section">
        <view class="section-header">
          <text class="section-icon">✓</text>
          <view class="section-title">已结束的演出</view>
        </view>

        <view class="performance-list">
          <view wx:for="{{endedPerformances}}" wx:key="id"
                class="performance-card"
                bindtap="viewPerformance"
                data-performance-id="{{item.id}}">
            <view class="performance-info">
              <view class="performance-title">{{item.title}}</view>
              <view class="performance-time">开始于 {{formatTime(item.startTime)}}</view>
              <view class="performance-stats">
                <view class="stat-item">
                  <text class="stat-icon">👥</text>
                  <text>{{item.audienceCount}} 观众</text>
                </view>
                <view class="stat-item">
                  <text class="stat-icon">🎵</text>
                  <text>{{item.singingList.length}} 歌曲</text>
                </view>
              </view>
            </view>
            <view class="performance-status ended">已结束</view>
          </view>
        </view>

        <view wx:if="{{endedPerformances.length === 0}}" class="empty-state">
          <view class="empty-icon">📋</view>
          <view class="empty-text">暂无已结束的演出</view>
        </view>
      </view>

      <!-- 我的点歌记录 -->
      <view class="section">
        <view class="section-header">
          <text class="section-icon">🎵</text>
          <view class="section-title">我的点歌记录</view>
        </view>

        <view class="point-record-list">
          <view wx:for="{{pointRecords}}" wx:key="id" class="record-card">
            <view class="record-info">
              <view class="song-name">{{item.songName}}</view>
              <view class="song-artist">{{item.songArtist}}</view>
              <view class="record-time">{{formatTime(item.createdAt)}}</view>
            </view>
            <view class="record-status {{item.status}}">
              {{item.status === 'pending' ? '待唱' : item.status === 'sung' ? '已唱' : '已取消'}}
            </view>
          </view>
        </view>

        <view wx:if="{{pointRecords.length === 0}}" class="empty-state">
          <view class="empty-icon">📝</view>
          <view class="empty-text">暂无点歌记录</view>
        </view>
      </view>
    </view>
  </view>
</scroll-view>
