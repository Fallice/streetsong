/* 隐私政策页面样式 */
page {
  background: #FAF7F2;
}

page {
  height: 100vh;
  background: #FAF7F2;
}

.container {
  height: calc(100vh - 88rpx); /* 减去导航栏高度 */
  padding: 32rpx;
  padding-bottom: 100rpx; /* 增加底部padding防止内容被遮挡 */
  box-sizing: border-box;
}

.content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 36, 25, 0.06);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2C2419;
  text-align: center;
  margin-bottom: 16rpx;
}

.update-time {
  font-size: 24rpx;
  color: #8B7D6B;
  text-align: center;
  margin-bottom: 48rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.section-content {
  font-size: 28rpx;
  color: #5C5143;
  line-height: 1.8;
  margin-bottom: 12rpx;
  text-align: justify;
}

.section-content:last-child {
  margin-bottom: 0;
}
