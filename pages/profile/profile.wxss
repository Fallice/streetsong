/* pages/profile/profile.wxss - 温暖音乐现场主题 */

page {
  height: 100vh;
  background: #FAF7F2;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 600rpx;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E0D4;
  border-top: 4rpx solid #D4A574;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8B7D6B;
}

.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* ===== 未登录页面 ===== */
.not-login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 180rpx;
  box-sizing: border-box;
}

.not-login-page .app-icon {
  margin-bottom: 32rpx;
  animation: float 3s ease-in-out infinite;
  display: flex;
  align-items: center;
  justify-content: center;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.not-login-page .app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.not-login-page .app-slogan {
  font-size: 28rpx;
  color: #8B7D6B;
  margin-bottom: 80rpx;
  font-weight: 400;
}

/* 登录按钮 */
.login-btn {
  width: 560rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.login-btn::after {
  border: none;
}

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

/* ===== 用户信息卡片 ===== */
.user-card {
  padding: 40rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  box-shadow:
    0 4rpx 24rpx rgba(212, 165, 116, 0.1),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 32rpx;
  transition: all 0.3s ease;
}

.user-card:active {
  transform: translateY(2rpx);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  margin-right: 32rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.user-info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-nickname {
  font-size: 38rpx;
  font-weight: 600;
  color: #2C2419;
}

.user-phone {
  font-size: 26rpx;
  color: #8B7D6B;
}

/* ===== 菜单卡片 ===== */
.menu-card {
  padding: 36rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
}

.menu-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.menu-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2419;
}

.arrow {
  font-size: 32rpx;
  color: #B5A99A;
  transition: transform 0.2s ease;
}

.menu-card:active .arrow {
  transform: translateX(4rpx);
}

/* ===== 退出登录按钮 ===== */
.logout-btn {
  margin-top: 60rpx;
  padding: 32rpx;
  text-align: center;
  color: #B5A99A;
  font-size: 28rpx;
  transition: color 0.2s ease;
}

.logout-btn:active {
  color: #E07A5F;
}

/* ===== 底部导航 ===== */
.bottom-tabs {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 112rpx;
  background: #FFFFFF;
  border-radius: 56rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 165, 116, 0.15),
    0 2rpx 8rpx rgba(44, 36, 25, 0.08);
  display: flex;
  align-items: center;
  padding: 8rpx;
  box-sizing: border-box;
  z-index: 100;
}

.bottom-tab {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8B7D6B;
  border-radius: 48rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.bottom-tab.active {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
}
