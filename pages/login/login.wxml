<!--pages/login/login.wxml-->
<navigation-bar title="登录" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="login-container">
  <!-- 顶部品牌区域 -->
  <view class="brand-section">
    <view class="app-icon">🎤</view>
    <text class="app-name">街唱</text>
    <text class="app-slogan">扫码点歌，随时演唱</text>
  </view>

  <!-- 登录区域 -->
  <view class="login-section">
    <!-- 协议勾选 -->
    <view class="agreement-box">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox class="agreement-checkbox" value="1" checked="{{isAgreed}}" />
          <text class="agreement-text">我已阅读并同意</text>
        </label>
      </checkbox-group>
      <text class="agreement-link" bindtap="showAgreement">《用户协议》</text>
      <text class="agreement-text">和</text>
      <text class="agreement-link" bindtap="showPrivacy">《隐私政策》</text>
    </view>

    <!-- 一键登录按钮 -->
    <button
      class="phone-login-btn {{isAgreed ? '' : 'disabled'}}"
      bindtap="onWechatLogin"
      disabled="{{!isAgreed}}"
    >
      <text class="btn-icon">📱</text>
      <text class="btn-text">微信一键登录</text>
    </button>

    <!-- 提示文字 -->
    <text class="login-tip">未注册用户将自动创建账号</text>
  </view>
</view>

<!-- 用户信息完善弹窗 -->
<view class="modal-mask" wx:if="{{showProfileModal}}" bindtap="closeModal"></view>
<view class="modal-content" wx:if="{{showProfileModal}}">
  <view class="modal-header">
    <text class="modal-title">完善个人信息</text>
  </view>

  <view class="modal-body">
    <!-- 头像选择 -->
    <view class="avatar-section">
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{tempAvatarUrl}}" class="avatar-img" src="{{tempAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">+</text>
          <text class="avatar-text">点击设置头像</text>
        </view>
      </button>
    </view>

    <!-- 昵称输入 -->
    <view class="nickname-section">
      <view class="input-box">
        <text class="input-label">昵称</text>
        <input
          class="nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          placeholder-class="input-placeholder"
          value="{{tempNickName}}"
          bindblur="onNicknameInput"
        />
      </view>
    </view>
  </view>

  <view class="modal-footer">
    <button
      class="confirm-btn {{tempNickName && tempAvatarUrl ? '' : 'disabled'}}"
      bindtap="completeProfile"
      disabled="{{!tempNickName || !tempAvatarUrl}}"
    >
      完成
    </button>
  </view>
</view>
