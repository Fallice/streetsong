/* pages/login/login.wxss - 温暖音乐现场主题 */

page {
  height: 100vh;
  background: linear-gradient(180deg, #FAF7F2 0%, #F5F0E8 100%);
}

.login-container {
  padding: 40rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== 品牌区域 ===== */
.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  margin-bottom: 80rpx;
}

.app-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.app-name {
  font-size: 56rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #8B7D6B;
  font-weight: 400;
}

/* ===== 登录区域 ===== */
.login-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ===== 协议勾选 ===== */
.agreement-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 60rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-checkbox {
  transform: scale(0.8);
}

.agreement-text {
  font-size: 24rpx;
  color: #8B7D6B;
}

.agreement-link {
  font-size: 24rpx;
  color: #D4A574;
  margin: 0 4rpx;
  font-weight: 500;
}

/* ===== 一键登录按钮 ===== */
.phone-login-btn {
  width: 560rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 32rpx;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.phone-login-btn::after {
  border: none;
}

.phone-login-btn.disabled {
  background: #E8E0D4;
  box-shadow: none;
}

.phone-login-btn.disabled .btn-text {
  color: #8B7D6B;
}

.phone-login-btn.disabled .btn-icon {
  opacity: 0.6;
}

.phone-login-btn:not(.disabled):active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 取消登录按钮 */
.cancel-login-btn {
  width: 560rpx;
  height: 96rpx;
  background: transparent;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 16rpx;
  padding: 0;
}

.cancel-login-btn::after {
  border: none;
}

.cancel-login-btn .btn-text {
  font-size: 30rpx;
  color: #8B7D6B; /* 增加灰度，让文字更清晰可见 */
  font-weight: 400;
}

.cancel-login-btn:active .btn-text {
  color: #5C5143;
}

/* 提示文字 */
.login-tip {
  font-size: 24rpx;
  color: #B5A99A;
  margin-top: 24rpx;
}

/* ===== 弹窗遮罩 ===== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  z-index: 999;
}

/* ===== 弹窗内容 ===== */
.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  z-index: 1000;
  overflow: hidden;
  box-shadow:
    0 20rpx 60rpx rgba(44, 36, 25, 0.2),
    0 8rpx 24rpx rgba(212, 165, 116, 0.15);
}

.modal-header {
  padding: 40rpx 32rpx 20rpx;
  text-align: center;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #2C2419;
}

.modal-body {
  padding: 32rpx;
}

/* ===== 头像区域 ===== */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 200rpx;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #E8C9A0;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F5F0E8;
  border: 4rpx dashed #D4A574;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.avatar-placeholder:active {
  background: #E8C9A0;
}

.avatar-plus {
  font-size: 48rpx;
  color: #D4A574;
  font-weight: 300;
  line-height: 1;
}

.avatar-text {
  font-size: 20rpx;
  color: #8B7D6B;
  margin-top: 8rpx;
}

/* ===== 昵称输入 ===== */
.nickname-section {
  margin-bottom: 20rpx;
}

.input-box {
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.input-box:focus-within {
  border-color: #D4A574;
  background: #FFFFFF;
}

.input-label {
  font-size: 28rpx;
  color: #5C5143;
  margin-right: 24rpx;
  width: 80rpx;
  font-weight: 500;
}

.nickname-input {
  flex: 1;
  font-size: 32rpx;
  color: #2C2419;
  background: transparent;
  border: none;
  height: 48rpx;
  line-height: 48rpx;
}

.input-placeholder {
  color: #B5A99A;
}

/* ===== 弹窗底部按钮 ===== */
.modal-footer {
  padding: 20rpx 32rpx 40rpx;
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn:not(.disabled):active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

.confirm-btn.disabled {
  background: #E8E0D4;
  color: #8B7D6B;
  box-shadow: none;
}
