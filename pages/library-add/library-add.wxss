/* 添加歌曲页面 - 温暖音乐现场主题 */
page {
  background: #FAF7F2;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 页面头部 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
}

.header-left {
  flex: 1;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #8B7D6B;
}

.header-right {
  flex-shrink: 0;
  margin-left: 24rpx;
}

.add-btn {
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
}

.add-btn.enabled {
  color: #D4A574;
}

.add-btn.enabled:active {
  opacity: 0.6;
}

.add-btn:not(.enabled) {
  color: #B5A99A;
}

/* ===== 输入组 ===== */
.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #5C5143;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #2C2419;
  box-sizing: border-box;
  border: 2rpx solid #E8E0D4;
  transition: all 0.2s ease;
}

.input:focus {
  border-color: #D4A574;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.input::placeholder {
  color: #B5A99A;
}
