/* 添加歌曲页面 - 温暖音乐现场主题 */
page {
  background: #FAF7F2;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ===== 页面头部 ===== */
.page-header {
  margin-bottom: 48rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 12rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 输入组 ===== */
.input-group {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #5C5143;
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #2C2419;
  box-sizing: border-box;
  border: 2rpx solid #E8E0D4;
  transition: all 0.2s ease;
}

.input:focus {
  border-color: #D4A574;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.input::placeholder {
  color: #B5A99A;
}

/* ===== 确认按钮 ===== */
.confirm-section {
  margin-top: auto;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(212, 165, 116, 0.4);
}

.confirm-btn.enabled:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(212, 165, 116, 0.3);
}

.confirm-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
}
