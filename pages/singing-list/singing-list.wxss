/* 扫码点歌页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
}

/* 固定区域 */
.fixed-section {
  flex-shrink: 0;
  padding: 32rpx;
  padding-bottom: 16rpx;
  background: #FAF7F2;
  z-index: 10;
}

/* 可滚动区域 */
.scrollable-section {
  flex: 1;
  overflow-y: auto;
}

.scrollable-section .container {
  padding: 0 32rpx;
  padding-bottom: 200rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.empty-state .empty-icon {
  margin-bottom: 32rpx;
}

.icon-bg {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D4 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 34rpx;
  color: #2C2419;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 区块标题 ===== */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 20rpx;
  display: block;
}

/* ===== 正在演唱卡片 ===== */
.current-song-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(224, 122, 95, 0.15);
  border: 2rpx solid rgba(224, 122, 95, 0.1);
}

.current-song-card .song-number {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.song-detail {
  flex: 1;
  min-width: 0;
}

.song-detail .song-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-detail .song-artist {
  font-size: 28rpx;
  color: #8B7D6B;
}

.playing-indicator {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 40rpx;
}

.wave {
  width: 6rpx;
  background: linear-gradient(180deg, #E07A5F 0%, #C96A52 100%);
  border-radius: 3rpx;
  animation: wave 1s ease-in-out infinite;
}

.wave:nth-child(1) {
  height: 20rpx;
  animation-delay: 0s;
}

.wave:nth-child(2) {
  height: 40rpx;
  animation-delay: 0.2s;
}

.wave:nth-child(3) {
  height: 28rpx;
  animation-delay: 0.4s;
}

@keyframes wave {
  0%, 100% { transform: scaleY(0.5); }
  50% { transform: scaleY(1); }
}

/* ===== 下一首卡片 ===== */
.next-song-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 36, 25, 0.06);
}

.next-song-card .song-number {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.song-info-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-width: 0;
}

.song-info-row .song-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #2C2419;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-info-row .song-artist {
  font-size: 26rpx;
  color: #8B7D6B;
  flex-shrink: 0;
}

/* ===== 待唱列表 ===== */
.pending-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 36, 25, 0.06);
}

.pending-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F5F0E8;
  transition: all 0.2s ease;
}

.pending-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.pending-item:first-child {
  padding-top: 0;
}

.pending-item:active {
  background: #FAF7F2;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 12rpx;
}

.pending-item .song-number {
  width: 56rpx;
  height: 56rpx;
  background: #F5F0E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #8B7D6B;
  flex-shrink: 0;
}

.pending-card {
  flex: 1;
  min-width: 0;
  background: #FAF7F2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.song-message {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #E8E0D4;
}

.message-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #8B7D6B;
  line-height: 1.5;
}

.like-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.like-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E0D4;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.like-btn:active {
  transform: scale(0.95);
}

.like-btn.liked {
  background: rgba(255, 0, 0, 0.1);
  border-color: #FF0000;
}

.like-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.like-text {
  font-size: 22rpx;
  color: #8B7D6B;
  font-weight: 500;
}

.like-btn.liked .like-text {
  color: #FF0000;
}

.like-count {
  font-size: 24rpx;
  color: #8B7D6B;
  font-weight: 500;
}

/* ===== 底部按钮 ===== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 48rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(44, 36, 25, 0.06);
  z-index: 100;
}

.point-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(224, 122, 95, 0.4);
  transition: all 0.3s ease;
}

.point-btn::after {
  border: none;
}

.point-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(224, 122, 95, 0.3);
}

.point-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
  box-shadow: none;
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 680rpx;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 60rpx rgba(44, 36, 25, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  flex-shrink: 0;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #2C2419;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8B7D6B;
  transition: all 0.2s ease;
}

.modal-close:active {
  color: #2C2419;
  transform: scale(0.9);
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
}

.library-hint {
  font-size: 26rpx;
  color: #8B7D6B;
  margin-bottom: 20rpx;
  text-align: center;
}

.library-list {
  max-height: 400rpx;
  margin-bottom: 24rpx;
}

.library-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
}

.library-empty .empty-icon {
  margin-bottom: 16rpx;
}

.library-empty .empty-text {
  font-size: 28rpx;
  color: #8B7D6B;
}

.song-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.song-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FAF7F2;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.song-option:active {
  background: #F5F0E8;
}

.song-option.selected {
  background: rgba(212, 165, 116, 0.1);
  border-color: #D4A574;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 30rpx;
  color: #2C2419;
  font-weight: 500;
}

.option-artist {
  font-size: 26rpx;
  color: #8B7D6B;
}

.option-check {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 留言区域 */
.message-section {
  border-top: 2rpx solid #F0EBE3;
  padding-top: 24rpx;
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 26rpx;
  color: #5C5143;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.message-input {
  width: 100%;
  height: 120rpx;
  background: #FAF7F2;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #2C2419;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.message-input:focus {
  border-color: #D4A574;
  background: #FFFFFF;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #B5A99A;
  margin-top: 8rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx 32rpx;
  flex-shrink: 0;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.modal-btn::after {
  border: none;
}

.cancel-btn {
  background: #F5F0E8;
  color: #5C5143;
}

.cancel-btn:active {
  background: #E8E0D4;
}

.confirm-btn {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
}

.confirm-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

.confirm-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
  box-shadow: none;
}

/* 开发调试区域 */
.dev-section {
  margin-top: 60rpx;
  padding: 32rpx;
  background: rgba(224, 122, 95, 0.08);
  border-radius: 20rpx;
  border: 2rpx dashed #E07A5F;
  width: 100%;
  box-sizing: border-box;
}

.dev-title {
  font-size: 28rpx;
  color: #E07A5F;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.dev-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(224, 122, 95, 0.4);
  transition: all 0.3s ease;
  margin-bottom: 16rpx;
}

.dev-btn::after {
  border: none;
}

.dev-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 95, 0.3);
}

.dev-btn.secondary {
  background: #FFFFFF;
  color: #E07A5F;
  border: 2rpx solid #E07A5F;
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 95, 0.1);
}

.dev-btn.secondary:active {
  background: rgba(224, 122, 95, 0.1);
}
