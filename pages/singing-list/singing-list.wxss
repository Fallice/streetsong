/* 观众点歌列表页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 34rpx;
  color: #2C2419;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 歌曲列表 ===== */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 20rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  transition: all 0.3s ease;
}

.song-item.current {
  background: linear-gradient(135deg, rgba(224, 122, 95, 0.1) 0%, rgba(201, 106, 82, 0.05) 100%);
  border: 2rpx solid rgba(224, 122, 95, 0.2);
}

.song-item:not(.current):active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.song-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.song-index.playing {
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(224, 122, 95, 0.4); }
  50% { transform: scale(1.05); box-shadow: 0 0 0 8rpx rgba(224, 122, 95, 0); }
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.song-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2C2419;
}

.song-artist {
  font-size: 24rpx;
  color: #8B7D6B;
}

.status-badge {
  font-size: 22rpx;
  color: #E07A5F;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: rgba(224, 122, 95, 0.1);
  border-radius: 12rpx;
}

.like-section {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
  padding: 8rpx;
}

.like-count {
  font-size: 24rpx;
  color: #8B7D6B;
  font-weight: 500;
}

.like-count.liked {
  color: #E07A5F;
}

.like-icon {
  font-size: 32rpx;
}

/* ===== 底部按钮 ===== */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 48rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent 0%, #FAF7F2 30%);
  z-index: 100;
}

.point-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(212, 165, 116, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.point-btn::after {
  border: none;
}

.point-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(212, 165, 116, 0.3);
}

.point-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
  box-shadow: none;
}

.btn-icon {
  font-size: 36rpx;
  font-weight: 300;
}
