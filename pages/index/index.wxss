/* 首页样式 - 温暖音乐现场主题 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

/* 内容区 */
.content {
  flex: 1;
}

.container {
  padding: 32rpx;
}

/* ===== 顶部标签栏 ===== */
.tabs {
  display: flex;
  padding: 24rpx 48rpx 32rpx;
  gap: 60rpx;
  margin-bottom: 16rpx;
}

.tab {
  font-size: 34rpx;
  color: #8B7D6B;
  position: relative;
  padding-bottom: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab.active {
  color: #2C2419;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #D4A574, transparent);
  border-radius: 2rpx;
}

/* ===== 扫一扫入口 ===== */
.scan-entry {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 32rpx;
  transition: all 0.3s ease;
}

.scan-entry:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.scan-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

.scan-text {
  flex: 1;
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 500;
}

.arrow {
  font-size: 32rpx;
  color: #B5A99A;
  margin-left: 16rpx;
  transition: transform 0.2s ease;
}

.scan-entry:active .arrow {
  transform: translateX(4rpx);
}

/* 扫码提示 */
.scan-hint {
  text-align: center;
  padding: 32rpx;
  color: #8B7D6B;
  font-size: 28rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.create-text {
  font-size: 32rpx;
  color: #5C5143;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.create-btn {
  width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.create-btn::after {
  border: none;
}

.create-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

.empty-text {
  font-size: 28rpx;
  color: #8B7D6B;
  margin-bottom: 32rpx;
}

/* ===== 歌单列表 ===== */
.playlist-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.playlist-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.playlist-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.playlist-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.playlist-name {
  font-size: 32rpx;
  color: #2C2419;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.song-count {
  font-size: 26rpx;
  color: #8B7D6B;
}

.playlist-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qr-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.qr-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.qr-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.7;
}

/* ===== 底部导航 ===== */
.bottom-tabs {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 112rpx;
  background: #FFFFFF;
  border-radius: 56rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 165, 116, 0.15),
    0 2rpx 8rpx rgba(44, 36, 25, 0.08);
  display: flex;
  align-items: center;
  padding: 8rpx;
  z-index: 100;
}

.bottom-tab {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8B7D6B;
  border-radius: 48rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.bottom-tab.active {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
}
