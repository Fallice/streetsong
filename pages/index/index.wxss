/* 首页样式 - 温暖音乐现场主题 */

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

/* 固定的顶部标签栏 */
.tabs-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(216, 189, 158, 0.3);
  box-shadow: 0 2rpx 12rpx rgba(212, 165, 116, 0.1);
}

.tabs {
  display: flex;
  padding: 24rpx 48rpx 32rpx;
  gap: 60rpx;
  margin-bottom: 16rpx;
}

.tab {
  font-size: 34rpx;
  color: #8B7D6B;
  position: relative;
  padding-bottom: 12rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab.active {
  color: #2C2419;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #D4A574, transparent);
  border-radius: 2rpx;
}

/* 可滑动的内容区 */
.swiper {
  flex: 1;
  width: 100%;
  height: calc(100vh - 120rpx); /* 减去标签栏高度 */
}

.content {
  height: 100%;
}

.container {
  padding: 32rpx;
}

/* ===== 扫一扫入口 ===== */
.scan-entry {
  display: flex;
  align-items: center;
  padding: 36rpx 40rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 32rpx;
  transition: all 0.3s ease;
}

.scan-entry:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.scan-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(212, 165, 116, 0.3);
}

.scan-text {
  flex: 1;
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 500;
}

.arrow {
  font-size: 32rpx;
  color: #B5A99A;
  margin-left: 16rpx;
  transition: transform 0.2s ease;
}

.scan-entry:active .arrow {
  transform: translateX(4rpx);
}

/* 扫码提示 */
.scan-hint {
  text-align: center;
  padding: 32rpx;
  color: #8B7D6B;
  font-size: 28rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 32rpx;
}

.empty-icon {
  margin-bottom: 24rpx;
  opacity: 0.6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-text {
  font-size: 32rpx;
  color: #5C5143;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.create-btn {
  width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.create-btn::after {
  border: none;
}

.create-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}

.empty-text {
  font-size: 28rpx;
  color: #8B7D6B;
  margin-bottom: 32rpx;
}

/* ===== 歌单列表 ===== */
.playlist-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.playlist-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 24rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
}

.playlist-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

/* 演唱中卡片样式 */
.playlist-card.singing {
  border: 3rpx solid rgba(224, 122, 95, 0.5);
  box-shadow: 0 4rpx 24rpx rgba(224, 122, 95, 0.2);
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F5 100%);
}

.playlist-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.playlist-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.playlist-name {
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 600;
}

/* 演唱中标记 */
.singing-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  border-radius: 20rpx;
  padding: 6rpx 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(224, 122, 95, 0.4);
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.singing-text {
  font-size: 18rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.song-count {
  font-size: 26rpx;
  color: #8B7D6B;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.singing-status {
  color: #E07A5F;
  font-weight: 600;
}

.playlist-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qr-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.qr-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.qr-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.qr-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

/* ===== 创建歌单按钮区域 ===== */
.create-playlist-section {
  margin-top: 20rpx;
  margin-bottom: 180rpx;
}

.create-playlist-card {
  justify-content: center;
  padding: 32rpx;
}

.create-playlist-card .create-btn {
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: #D4A574;
  border: 2rpx dashed #D4A574;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: none;
  transition: all 0.3s ease;
}

.create-playlist-card .create-btn::after {
  border: none;
}

.create-playlist-card .create-btn:active {
  background: rgba(212, 165, 116, 0.1);
  transform: scale(0.98);
  box-shadow: none;
}

/* ===== 底部导航 ===== */
.bottom-tabs {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 112rpx;
  background: #FFFFFF;
  border-radius: 56rpx;
  box-shadow:
    0 8rpx 32rpx rgba(212, 165, 116, 0.15),
    0 2rpx 8rpx rgba(44, 36, 25, 0.08);
  display: flex;
  align-items: center;
  padding: 8rpx;
  z-index: 100;
}

.bottom-tab {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8B7D6B;
  border-radius: 48rpx;
  transition: all 0.3s ease;
  font-weight: 500;
}

.bottom-tab.active {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
}
