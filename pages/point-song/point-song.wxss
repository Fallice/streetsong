/* 点歌页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.container {
  padding: 32rpx;
  flex: 1;
}

/* ===== 搜索框 ===== */
.search-section {
  margin-bottom: 32rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  border: 2rpx solid #E8E0D4;
  transition: all 0.2s ease;
}

.search-input-wrapper:focus-within {
  border-color: #D4A574;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #B5A99A;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #2C2419;
}

.search-input::placeholder {
  color: #B5A99A;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8E0D4;
  border-radius: 50%;
  font-size: 22rpx;
  color: #FFFFFF;
}

/* ===== 曲库信息 ===== */
.library-info,
.search-result-info {
  margin-bottom: 32rpx;
}

.library-text {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #8B7D6B;
}

.library-icon {
  font-size: 32rpx;
}

.search-text {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 歌曲列表 ===== */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.song-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.song-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-top: 16rpx;
}

.song-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 20rpx;
  box-shadow:
    0 4rpx 20rpx rgba(212, 165, 116, 0.08),
    0 1rpx 4rpx rgba(44, 36, 25, 0.04);
  transition: all 0.3s ease;
}

.song-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 12rpx rgba(212, 165, 116, 0.06),
    0 1rpx 2rpx rgba(44, 36, 25, 0.02);
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.song-name {
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 500;
}

.song-artist {
  font-size: 26rpx;
  color: #8B7D6B;
}

.point-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
  padding: 8rpx;
}

.point-icon-bg {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(224, 122, 95, 0.3);
  transition: all 0.2s ease;
}

.point-icon-bg:active {
  transform: scale(0.95);
}

.point-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.point-text {
  font-size: 22rpx;
  color: #E07A5F;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: #8B7D6B;
}

/* ===== 点歌弹窗 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 640rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCF8 100%);
  border-radius: 28rpx;
  padding: 40rpx;
  box-shadow:
    0 20rpx 60rpx rgba(44, 36, 25, 0.2),
    0 8rpx 24rpx rgba(212, 165, 116, 0.15);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2419;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 50%;
  font-size: 28rpx;
  color: #8B7D6B;
  transition: all 0.2s ease;
}

.close-btn:active {
  background: #E8C9A0;
  color: #5C5143;
}

.song-info-modal {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 16rpx;
}

.song-info-modal .song-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2419;
  margin-bottom: 8rpx;
  text-align: center;
}

.song-info-modal .song-artist {
  font-size: 28rpx;
  color: #8B7D6B;
  text-align: center;
}

/* ===== 寄语输入 ===== */
.message-section {
  margin-bottom: 32rpx;
}

.message-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #5C5143;
  margin-bottom: 16rpx;
}

.message-input {
  width: 100%;
  height: 160rpx;
  background: #F5F0E8;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #2C2419;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.message-input:focus {
  border-color: #D4A574;
  background: #FFFFFF;
}

.message-input::placeholder {
  color: #B5A99A;
}

.message-count {
  text-align: right;
  font-size: 24rpx;
  color: #B5A99A;
  margin-top: 12rpx;
}

/* ===== 弹窗底部按钮 ===== */
.modal-footer {
  display: flex;
  justify-content: center;
}

.point-btn-modal {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.point-btn-modal::after {
  border: none;
}

.point-btn-modal:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(212, 165, 116, 0.3);
}
