/* 点歌页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 32rpx;
}

/* ===== 搜索框 ===== */
.search-section {
  margin-bottom: 32rpx;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  border: 2rpx solid #E8E0D4;
  transition: all 0.2s ease;
}

.search-input-wrapper:focus-within {
  border-color: #D4A574;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #B5A99A;
}

.search-input {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  color: #2C2419;
}

.search-input::placeholder {
  color: #B5A99A;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8E0D4;
  border-radius: 50%;
  font-size: 22rpx;
  color: #FFFFFF;
}

/* ===== 曲库信息 ===== */
.library-info,
.search-result-info {
  margin-bottom: 32rpx;
}

.library-text {
  font-size: 30rpx;
  color: #2C2419;
  font-weight: 500;
}

.search-text {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 歌曲列表 ===== */
.song-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.song-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.song-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.song-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 36, 25, 0.06);
  transition: all 0.2s ease;
}

.song-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(44, 36, 25, 0.04);
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.song-name {
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist {
  font-size: 26rpx;
  color: #8B7D6B;
}

.point-btn-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-left: 16rpx;
  padding: 8rpx;
}

.point-btn-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(224, 122, 95, 0.3);
  transition: all 0.2s ease;
}

.point-btn-circle:active {
  transform: scale(0.95);
}

.point-icon {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

.point-text {
  font-size: 22rpx;
  color: #E07A5F;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-state .empty-icon {
  margin-bottom: 32rpx;
}

.icon-bg {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D4 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8B7D6B;
}

/* ===== 点歌弹窗 ===== */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(44, 36, 25, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 640rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(44, 36, 25, 0.2);
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C2419;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.modal-close:active {
  background: #E8C9A0;
}

/* 歌曲信息 */
.song-info-modal {
  margin-bottom: 40rpx;
}

.song-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.song-name-modal {
  font-size: 44rpx;
  font-weight: 600;
  color: #2C2419;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.song-artist-modal {
  font-size: 28rpx;
  color: #8B7D6B;
  flex-shrink: 0;
}

/* 留言输入 */
.message-section {
  margin-bottom: 48rpx;
}

.message-label {
  font-size: 30rpx;
  color: #2C2419;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 500;
}

.message-input {
  width: 100%;
  height: 160rpx;
  background: #FFFFFF;
  border: 2rpx solid #E8E0D4;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #2C2419;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.message-input:focus {
  border-color: #D4A574;
}

.message-input::placeholder {
  color: #B5A99A;
}

/* 点歌按钮 */
.modal-footer {
  display: flex;
  justify-content: center;
}

.point-btn-modal {
  width: 400rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(224, 122, 95, 0.4);
  transition: all 0.3s ease;
}

.point-btn-modal::after {
  border: none;
}

.point-btn-modal:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(224, 122, 95, 0.3);
}
