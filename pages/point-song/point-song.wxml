<navigation-bar title="点歌" back="{{true}}" color="black" background="#FAF7F2"></navigation-bar>

<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-section">
      <view class="search-input-wrapper">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索歌曲" value="{{searchText}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
        <view wx:if="{{searchText}}" class="clear-btn" bindtap="clearSearch">
          <text>✕</text>
        </view>
      </view>
    </view>

    <!-- 曲库信息 -->
    <view class="library-info" wx:if="{{!searchText}}">
      <text class="library-text">歌手曲库，共计 {{songLibrary.length}} 首</text>
      <text class="quota-text">本场已点 {{orderedCount}}/{{maxOrderLimit}} 首{{orderedCount >= maxOrderLimit ? '（已满）' : ''}}</text>
    </view>

    <!-- 搜索结果信息 -->
    <view class="search-result-info" wx:if="{{searchText}}">
      <view class="search-text">查找到 {{filteredSongs.length}} 首歌曲</view>
    </view>

    <!-- 歌曲列表 -->
    <view class="song-list">
      <view wx:for="{{displaySongs}}" wx:key="id" class="song-item">
        <view class="song-index">{{index + 1}}</view>
        <view class="song-card">
          <view class="song-info">
            <text class="song-name">{{item.name}}</text>
            <text class="song-artist">{{item.artist}}</text>
          </view>
          <view class="point-btn-wrapper" bindtap="showPointModal" data-song="{{item}}">
            <view class="point-btn-circle">
              <text class="point-icon">+</text>
            </view>
            <text class="point-text">点歌</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{displaySongs.length === 0}}">
      <view class="empty-icon">
        <view class="icon-bg">🎵</view>
      </view>
      <view class="empty-text">{{searchText ? '未找到匹配的歌曲' : '曲库为空'}}</view>
    </view>
  </view>
</scroll-view>

<!-- 点歌弹窗 -->
<view class="modal {{showPointModal ? 'show' : ''}}" bindtap="hidePointModal">
  <view class="modal-content" catchtap="stopPropagation">
    <!-- 弹窗头部 -->
    <view class="modal-header">
      <view class="modal-title">确认点歌</view>
      <view class="modal-close" bindtap="hidePointModal">
        <icon name="close" size="32rpx" color="#8B7D6B" />
      </view>
    </view>

    <!-- 歌曲信息 -->
    <view class="song-info-modal">
      <view class="song-info-row">
        <text class="song-name-modal">{{selectedSong.name}}</text>
        <text class="song-artist-modal">{{selectedSong.artist}}</text>
      </view>
    </view>

    <!-- 留言区域 -->
    <view class="message-section">
      <view class="message-label">点歌寄语</view>
      <textarea class="message-input" placeholder="写下你想说的话" value="{{pointMessage}}" bindinput="onMessageInput" maxlength="50" />
    </view>

    <!-- 点歌按钮 -->
    <view class="modal-footer">
      <button class="point-btn-modal" bindtap="confirmPointSong">确认点歌（剩余{{maxOrderLimit - orderedCount}}次）</button>
    </view>
  </view>
</view>
