/* 创建歌单页面 - 温暖音乐现场主题 */
page {
  background: #FAF7F2;
  height: 100vh;
}

.container {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-top: 40rpx;
}

/* ===== 页面头部 ===== */
.page-header {
  margin-bottom: 48rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 16rpx;
}

.page-subtitle {
  font-size: 28rpx;
  color: #8B7D6B;
}

/* ===== 输入区域 ===== */
.input-section {
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #5C5143;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.playlist-name-input {
  width: 100%;
  height: 100rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #2C2419;
  border: 2rpx solid #E8E0D4;
  transition: all 0.2s ease;
}

.playlist-name-input:focus {
  border-color: #D4A574;
  box-shadow: 0 0 0 4rpx rgba(212, 165, 116, 0.1);
}

.playlist-name-input::placeholder {
  color: #B5A99A;
}

.input-hint {
  text-align: right;
  font-size: 24rpx;
  color: #B5A99A;
  margin-top: 12rpx;
}

/* ===== 提示 ===== */
.hint {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(212, 165, 116, 0.1);
  border-radius: 16rpx;
  margin-bottom: 60rpx;
}

.hint-icon {
  font-size: 28rpx;
}

.hint-text {
  font-size: 26rpx;
  color: #8B7D6B;
}

/* ===== 确认按钮 ===== */
.confirm-section {
  margin-top: 0;
  margin-bottom: auto;
  padding-bottom: 0;
}

.confirm-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-btn::after {
  border: none;
}

.confirm-btn.enabled {
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(212, 165, 116, 0.4);
}

.confirm-btn.enabled:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(212, 165, 116, 0.3);
}

.confirm-btn.disabled {
  background: #E8E0D4;
  color: #B5A99A;
}
