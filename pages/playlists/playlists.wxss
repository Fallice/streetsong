/* 我的歌单页面 - 温暖音乐现场主题 */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF7F2;
}

.scrollarea {
  flex: 1;
  overflow-y: auto;
}

.container {
  padding: 32rpx;
  padding-bottom: 180rpx;
}

/* ===== 页面头部 ===== */
.page-header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2C2419;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #8B7D6B;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  margin-bottom: 32rpx;
}

.icon-bg {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #F5F0E8 0%, #E8E0D4 100%);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 34rpx;
  color: #2C2419;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #8B7D6B;
  margin-bottom: 48rpx;
}

/* ===== 创建按钮 ===== */
.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 280rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #D4A574 0%, #B88A5A 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
  transition: all 0.3s ease;
}

.create-btn::after {
  border: none;
}

.create-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(212, 165, 116, 0.3);
}

.btn-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 歌单列表 ===== */
.playlist-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.playlist-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 36, 25, 0.06);
  transition: all 0.2s ease;
}

.playlist-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(44, 36, 25, 0.04);
}

.playlist-main {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx 16rpx 24rpx;
}

/* 歌单封面 */
.playlist-cover {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #E8C9A0 0%, #D4A574 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  position: relative;
  overflow: visible;
}

.cover-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 演唱中标记 */
.singing-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: linear-gradient(135deg, #E07A5F 0%, #C96A52 100%);
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(224, 122, 95, 0.5);
  animation: pulse 1.5s ease-in-out infinite;
  z-index: 10;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.singing-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.singing-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 演唱中卡片样式 */
.playlist-card.singing {
  border: 3rpx solid rgba(224, 122, 95, 0.5);
  box-shadow: 0 4rpx 24rpx rgba(224, 122, 95, 0.2);
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F5 100%);
}

.singing-status {
  color: #E07A5F;
  font-weight: 600;
  margin-left: 12rpx;
  font-size: 26rpx;
}

/* 歌单信息 */
.playlist-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.playlist-name {
  font-size: 32rpx;
  color: #2C2419;
  font-weight: 600;
}

.playlist-meta {
  font-size: 26rpx;
  color: #8B7D6B;
}

/* 箭头 */
.arrow-icon {
  margin-left: 16rpx;
}

/* 操作按钮区域 */
.playlist-actions {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  border-left: 2rpx solid #F0EBE3;
  margin-right: 8rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F0E8;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  background: #E8C9A0;
  transform: scale(0.95);
}

.qr-btn .action-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ===== 创建歌单按钮区域 ===== */
.create-playlist-section {
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.create-playlist-card {
  justify-content: center;
  padding: 32rpx;
}

.create-playlist-card .create-btn {
  width: 100%;
  height: 72rpx;
  background: transparent;
  color: #D4A574;
  border: 2rpx dashed #D4A574;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: none;
  transition: all 0.3s ease;
}

.create-playlist-card .create-btn::after {
  border: none;
}

.create-playlist-card .create-btn:active {
  background: rgba(212, 165, 116, 0.1);
  transform: scale(0.98);
  box-shadow: none;
}
