/* 底部导航栏样式 tab-bar.wxss */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: white;
  display: flex;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  transition: all 0.2s;
}

.tab-bar-item:active {
  opacity: 0.7;
}

.tab-bar-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
  opacity: 0.5;
  transition: all 0.2s;
}

.tab-bar-item.active .tab-bar-icon {
  opacity: 1;
}

.tab-bar-text {
  font-size: 20rpx;
  color: #666666;
  line-height: 1;
  transition: all 0.2s;
}

.tab-bar-item.active .tab-bar-text {
  color: #FF4D4F;
  font-weight: 500;
}